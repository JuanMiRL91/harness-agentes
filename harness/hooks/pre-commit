#!/usr/bin/env bash
# harness/hooks/pre-commit — comment gate on the staged files.
# Enabled via `git config core.hooksPath harness/hooks` (init.sh sets it). Skip once: git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if python3 -c "import sys; sys.exit(0 if sys.version_info >= (3,9) else 1)" 2>/dev/null; then
    PY="python3"
elif python -c "import sys; sys.exit(0 if sys.version_info >= (3,9) else 1)" 2>/dev/null; then
    PY="python"
else
    PY="python3"
fi

if ! "$PY" harness/check_comments.py --staged; then
    echo "" >&2
    echo "pre-commit: commit blocked — trim the comments (or git commit --no-verify)." >&2
    exit 1
fi
